<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RepositoryUrl>https://github.com/panoramicdata/PanoramicData.ECharts</RepositoryUrl>
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
    <!-- A demo web app, not a consumable library: it must never be packed or published. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PanoramicData.ECharts.Samples\PanoramicData.ECharts.Samples.csproj" />
    <ProjectReference Include="..\PanoramicData.ECharts\PanoramicData.ECharts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="wwwroot\css\site.css" />
  </ItemGroup>
</Project>